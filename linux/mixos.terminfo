# Capabilities are claimed only where mix_terminal.c actually implements them.
# Present: alternate screen, insert/delete line and character, erase character,
# scroll regions, 256 colours, direct colour, underline, cursor position report.
# Absent on purpose: mouse reporting, italics, blink, double-width lines, and
# any status line. The device has touch, not a mouse, and one font face.
# Compile manually: tic -x -o ~/.terminfo linux/mixos.terminfo
mixos|MixOS 80x28 ANSI terminal with alternate screen and 256 colours,
    am, bce, mir, msgr, npc,
    cols#80, lines#28, colors#256, pairs#32767, it#8,
    bel=^G, cr=^M, cud1=^J, cub1=^H, ind=^J, nel=\r\n,
    clear=\E[H\E[2J, el=\E[K, el1=\E[1K, ed=\E[J,
    home=\E[H, cup=\E[%i%p1%d;%p2%dH,
    cuu=\E[%p1%dA, cud=\E[%p1%dB, cuf=\E[%p1%dC, cub=\E[%p1%dD,
    cuu1=\E[A, cud1=^J, cuf1=\E[C, cub1=^H,
    hpa=\E[%i%p1%dG, vpa=\E[%i%p1%dd,
    il=\E[%p1%dL, il1=\E[L, dl=\E[%p1%dM, dl1=\E[M,
    ich=\E[%p1%d@, ich1=\E[@, dch=\E[%p1%dP, dch1=\E[P,
    ech=\E[%p1%dX, rep=%p1%c\E[%p2%{1}%-%db,
    indn=\E[%p1%dS, rin=\E[%p1%dT, ri=\EM,
    csr=\E[%i%p1%d;%p2%dr, sc=\E7, rc=\E8,
    ht=^I, hts=\EH, tbc=\E[3g, cbt=\E[Z, cht=\E[%p1%dI,
    smcup=\E[?1049h, rmcup=\E[?1049l,
    civis=\E[?25l, cnorm=\E[?25h,
    smam=\E[?7h, rmam=\E[?7l,
    sgr0=\E[0m, bold=\E[1m, dim=\E[2m, rev=\E[7m,
    smul=\E[4m, rmul=\E[24m, smso=\E[7m, rmso=\E[27m,
    setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38;5;%p1%d%;m,
    setab=\E[%?%p1%{8}%<%t4%p1%d%e%p1%{16}%<%t10%p1%{8}%-%d%e48;5;%p1%d%;m,
    setrgbf=\E[38;2;%p1%d;%p2%d;%p3%dm,
    setrgbb=\E[48;2;%p1%d;%p2%d;%p3%dm,
    op=\E[39;49m, u7=\E[6n, u6=\E[%i%d;%dR, u8=\E[?62;22c, u9=\E[c,
    rs1=\Ec, rs2=\E[!p\E[?7h\E[?25h, is2=\E[!p\E[?7h\E[?25h,
    kbs=^?, kent=^M, kcuu1=\E[A, kcud1=\E[B,
    kcuf1=\E[C, kcub1=\E[D, khome=\E[H, kend=\E[F,
    kdch1=\E[3~, kich1=\E[2~, knp=\E[6~, kpp=\E[5~,
    kf1=\EOP, kf2=\EOQ, kf3=\EOR, kf4=\EOS,
    kf5=\E[15~, kf6=\E[17~, kf7=\E[18~, kf8=\E[19~,
    kf9=\E[20~, kf10=\E[21~, kf11=\E[23~, kf12=\E[24~,
